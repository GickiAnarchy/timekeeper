rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == 'N9fh9kr98neSYBSNdyDHBZn9IGv1';
    }

    function isGuest() {
      return request.auth == null || !isOwner();
    }

    function hasRecentOwnerAuthentication() {
      return isOwner()
        && request.auth.token.auth_time is int
        && request.auth.token.auth_time > (request.time.toMillis() / 1000) - 300;
    }

    function safePublicEmployee(data) {
      return data.keys().hasAll(['name'])
        && data.keys().hasOnly(['name'])
        && data.name is string
        && data.name.size() <= 120;
    }

    function isSafeGuestLocation(value) {
      return value == null
        || (value is string
          && value.size() <= 160
          && !value.matches('^[0-9]+[a-zA-Z]?[ ]+.*$'));
    }

    function safePublicCustomer(data) {
      return data.keys().hasAll(['name', 'location'])
        && data.keys().hasOnly(['name', 'location'])
        && data.name is string
        && data.name.size() <= 160
        && isSafeGuestLocation(data.location);
    }

    function safePublicShift(data) {
      return data.keys().hasAll(['employeeId', 'custId', 'clockInTime', 'clockOutTime', 'breaks'])
        && data.keys().hasOnly(['employeeId', 'custId', 'clockInTime', 'clockOutTime', 'breaks'])
        && data.employeeId is string
        && data.custId is string
        && data.clockInTime is string
        && (data.clockOutTime == null || data.clockOutTime is string)
        && data.breaks is list
        && data.breaks.size() <= 50;
    }

    function referencesPublishedPeople(data) {
      return exists(/databases/$(database)/documents/publicEmployees/$(data.employeeId))
        && exists(/databases/$(database)/documents/publicCustomers/$(data.custId));
    }

    function validGuestClockIn() {
      return isGuest()
        && safePublicShift(request.resource.data)
        && request.resource.data.clockOutTime == null
        && request.resource.data.breaks.size() == 0
        && referencesPublishedPeople(request.resource.data);
    }

    function validGuestClockOut() {
      return isGuest()
        && safePublicShift(resource.data)
        && safePublicShift(request.resource.data)
        && resource.data.clockOutTime == null
        && request.resource.data.clockOutTime is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clockOutTime'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['clockOutTime']);
    }

    function validPendingRequest() {
      let data = request.resource.data;
      return data.status == 'pending'
        && data.submittedAt is string
        && data.requester is string
        && data.requester.size() <= 120
        && (
          (data.kind == 'write'
            && data.keys().hasAll(['kind', 'status', 'submittedAt', 'requester', 'operation', 'collection', 'documentId'])
            && data.keys().hasOnly(['kind', 'status', 'submittedAt', 'requester', 'operation', 'collection', 'documentId', 'data'])
            && data.operation in ['set', 'update', 'delete']
            && data.collection in ['employees', 'customers', 'payments', 'invoices', 'ledgerRows', 'planned', 'shifts']
            && data.documentId is string
            && data.documentId.size() > 0
            && data.documentId.size() <= 200
            && ((data.operation == 'delete' && !('data' in data))
              || (data.operation in ['set', 'update'] && data.data is map)))
          ||
          (data.kind == 'batch'
            && data.keys().hasAll(['kind', 'status', 'submittedAt', 'requester', 'operations'])
            && data.keys().hasOnly(['kind', 'status', 'submittedAt', 'requester', 'operations'])
            && data.operations is list
            && data.operations.size() > 0
            && data.operations.size() <= 499)
        );
    }

    // Fail closed for all collections not explicitly listed below.
    match /{document=**} {
      allow read, write: if false;
    }

    // Private workspace records remain owner-only; non-routine changes still
    // require a recently authenticated owner password.
    match /{collectionName}/{documentId} {
      allow read: if isOwner();
      allow create, update, delete: if hasRecentOwnerAuthentication()
        && collectionName in [
          'employees', 'customers', 'payments', 'invoices',
          'ledgerRows', 'planned'
        ];
    }

    match /shifts/{shiftId} {
      allow read: if isOwner();
      allow create: if isOwner() && (hasRecentOwnerAuthentication() || isNewActiveClockIn());
      allow update: if hasRecentOwnerAuthentication() || (isOwner() && isRoutineActiveShiftUpdate());
      allow delete: if hasRecentOwnerAuthentication();
    }

    // Guest-readable projections never contain payroll, notes, billing rates,
    // invoices, or numbered street addresses. Owners publish sanitized copies.
    match /publicEmployees/{employeeId} {
      allow read: if true;
      allow create, update: if isOwner() && safePublicEmployee(request.resource.data);
      allow delete: if isOwner();
    }

    match /publicCustomers/{customerId} {
      allow read: if true;
      allow create, update: if isOwner() && safePublicCustomer(request.resource.data);
      allow delete: if isOwner();
    }

    match /publicShifts/{shiftId} {
      allow read: if true;
      allow create: if (isOwner() && safePublicShift(request.resource.data)) || validGuestClockIn();
      allow update: if (isOwner() && safePublicShift(request.resource.data)) || validGuestClockOut();
      allow delete: if isOwner();
    }

    // Guests may create inert requests. Only the owner can inspect or resolve
    // them; request payloads are applied only by a recent-authenticated owner.
    match /changeRequests/{requestId} {
      allow read: if isOwner();
      allow create: if isGuest() && validPendingRequest();
      allow update: if hasRecentOwnerAuthentication()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'denied']
        && request.resource.data.reviewedAt is string
        && request.resource.data.reviewerNote is string
        && request.resource.data.reviewerNote.size() <= 500
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewerNote']);
      allow delete: if false;
    }

    // Routine owner clock-in rules retained from the production ruleset.
    function isNewActiveClockIn() {
      return request.resource.data.keys().hasAll([
          'employeeId', 'custId', 'clockInTime', 'clockOutTime',
          'note', 'isPaid', 'breaks', 'paidHours'
        ])
        && request.resource.data.keys().hasOnly([
          'employeeId', 'custId', 'clockInTime', 'clockOutTime',
          'note', 'isPaid', 'breaks', 'paidHours'
        ])
        && request.resource.data.employeeId is string
        && request.resource.data.custId is string
        && request.resource.data.clockInTime is string
        && request.resource.data.clockOutTime == null
        && request.resource.data.note == null
        && request.resource.data.isPaid == false
        && request.resource.data.breaks is list
        && request.resource.data.breaks.size() == 0
        && request.resource.data.paidHours == null;
    }

    function isRoutineActiveShiftUpdate() {
      return resource.data.clockInTime is string
        && resource.data.clockOutTime == null
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.custId == resource.data.custId
        && request.resource.data.clockInTime == resource.data.clockInTime
        && request.resource.data.note == resource.data.note
        && request.resource.data.isPaid == resource.data.isPaid
        && request.resource.data.paidHours == resource.data.paidHours
        && request.resource.data.breaks is list
        && (request.resource.data.clockOutTime == null || request.resource.data.clockOutTime is string)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clockOutTime', 'breaks'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny(['clockOutTime', 'breaks']);
    }
  }
}
